msgid ""
msgstr ""
"```python\n"
"import torch\n"
"import torch.nn as nn\n"
"import torch.nn.functional as F\n"
"import math\n"
"\n"
"# -------------------------------\n"
"# 1. Standard Attention Implementation\n"
"# -------------------------------\n"
"class StandardAttention(nn.Module):\n"
"    def __init__(self, d_model, n_heads):\n"
"        super().__init__()\n"
"        self.d_model = d_model\n"
"        self.n_heads = n_heads\n"
"        self.d_k = d_model // n_heads\n"
"        \n"
"        self.W_q = nn.Linear(d_model, d_model)\n"
"        self.W_k = nn.Linear(d_model, d_model)\n"
"        self.W_v = nn.Linear(d_model, d_model)\n"
"        self.W_o = nn.Linear(d_model, d_model)\n"
"        \n"
"    def forward(self, x, mask=None):\n"
"        batch_size, seq_len, _ = x.shape\n"
"        \n"
"        # Linear projections\n"
"        Q = self.W_q(x)\n"
"        K = self.W_k(x)\n"
"        V = self.W_v(x)\n"
"        \n"
"        # Reshape for multi-head attention\n"
"        Q = Q.view(batch_size, seq_len, self.n_heads, self.d_k).transpose(1, 2)\n"
"        K = K.view(batch_size, seq_len, self.n_heads, self.d_k).transpose(1, 2)\n"
"        V = V.view(batch_size, seq_len, self.n_heads, self.d_k).transpose(1, 2)\n"
"        \n"
"        # Compute attention scores\n"
"        scores = torch.matmul(Q, K.transpose(-2, -1)) / math.sqrt(self.d_k)\n"
"        \n"
"        if mask is not None:\n"
"            scores = scores.masked_fill(mask == 0, float('-inf'))\n"
"        \n"
"        # Softmax and attention output\n"
"        attn_weights = F.softmax(scores, dim=-1)\n"
"        attn_output = torch.matmul(attn_weights, V)\n"
"        \n"
"        # Concatenate heads and project\n"
"        attn_output = attn_output.transpose(1, 2).contiguous().view(batch_size, seq_len, -1)\n"
"        output = self.W_o(attn_output)\n"
"        \n"
"        return output\n"
"\n"
"# -------------------------------\n"
"# 2. Fused Attention Implementation\n"
"# -------------------------------\n"
"class FusedAttention(nn.Module):\n"
"    def __init__(self, d_model, n_heads):\n"
"        super().__init__()\n"
"        self.d_model = d_model\n"
"        self.n_heads = n_heads\n"
"        self.d_k = d_model // n_heads\n"
"        \n"
"        # Fused QKV projection\n"
"        self.W_qkv = nn.Linear(d_model, 3 * d_model)\n"
"        self.W_o = nn.Linear(d_model, d_model)\n"
"        \n"
"    def forward(self, x, mask=None):\n"
"        batch_size, seq_len, _ = x.shape\n"
"        \n"
"        # Fused QKV projection\n"
"        qkv = self.W_qkv(x)\n"
"        qkv = qkv.reshape(batch_size, seq_len, 3, self.n_heads, self.d_k)\n"
"        qkv = qkv.permute(2, 0, 3, 1, 4)  # [3, batch, heads, seq, d_k]\n"
"        Q, K, V = qkv[0], qkv[1], qkv[2]\n"
"        \n"
"        # Fused attention computation\n"
"        # Use scaled dot-product attention with optional mask\n"
"        attn_output = F.scaled_dot_product_attention(\n"
"            Q, K, V,\n"
"            attn_mask=mask,\n"
"            dropout_p=0.0,\n"
"            is_causal=False\n"
"        )\n"
"        \n"
"        # Reshape and project output\n"
"        attn_output = attn_output.transpose(1, 2).contiguous().view(batch_size, seq_len, -1)\n"
"        output = self.W_o(attn_output)\n"
"        \n"
"        return output\n"
"\n"
"# -------------------------------\n"
"# 3. Performance Comparison\n"
"# -------------------------------\n"
"def compare_performance():\n"
"    d_model = 512\n"
"    n_heads = 8\n"
"    batch_size = 32\n"
"    seq_len = 128\n"
"    \n"
"    # Create models\n"
"    standard_attn = StandardAttention(d_model, n_heads)\n"
"    fused_attn = FusedAttention(d_model, n_heads)\n"
"    \n"
"    # Create input\n"
"    x = torch.randn(batch_size, seq_len, d_model)\n"
"    mask = torch.ones(batch_size, 1, 1, seq_len).bool()\n"
"    \n"
"    # Warm-up\n"
"    for _ in range(10):\n"
"        _ = standard_attn(x, mask)\n"
"        _ = fused_attn(x, mask)\n"
"    \n"
"    # Benchmark standard attention\n"
"    torch.cuda.synchronize()\n"
"    start = torch.cuda.Event(enable_timing=True)\n"
"    end = torch.cuda.Event(enable_timing=True)\n"
"    \n"
"    start.record()\n"
"    for _ in range(100):\n"
"        _ = standard_attn(x, mask)\n"
"    end.record()\n"
"    torch.cuda.synchronize()\n"
"    standard_time = start.elapsed_time(end)\n"
"    \n"
"    # Benchmark fused attention\n"
"    start.record()\n"
"    for _ in range(100):\n"
"        _ = fused_attn(x, mask)\n"
"    end.record()\n"
"    torch.cuda.synchronize()\n"
"    fused_time = start.elapsed_time(end)\n"
"    \n"
"    print(f\"Standard Attention: {standard_time:.2f} ms\")\n"
"    print(f\"Fused Attention: {fused_time:.2f} ms\")\n"
"    print(f\"Speedup: {standard_time / fused_time:.2f}x\")\n"
"\n"
"if __name__ == \"__main__\":\n"
"    compare_performance()\n"
"```\n"

msgid "融合注意力（Fused Attention）"
msgstr "Fused Attention"

msgid "本节实现了一个基于 **Triton** 的 **Flash Attention v2 风格的融合注意力前向传播内核**，适用于昇腾（Ascend）NPU 平台。该实现支持："
msgstr "This section implements a **Triton-based Flash Attention v2-style fused attention forward kernel** for the Ascend NPU platform. The implementation supports:"

msgid "**因果（causal）与非因果注意力**"
msgstr "**Causal vs. Non-Causal Attention**"

msgid "**分块计算（tiling）以处理长序列**"
msgstr "**Tiling to Handle Long Sequences**"

msgid "**数值稳定性优化（max-shifted softmax）**"
msgstr "**Numerical Stability Optimization (max-shifted softmax)**"

msgid "整体结构包含两个核心 Triton 内核："
msgstr "The overall structure contains two core Triton kernels:"

msgid "`_attn_fwd_inner`：执行单个 query block 与 key/value blocks 的 attention 计算（分阶段处理 causal mask）"
msgstr "`_attn_fwd_inner`: Executes the attention computation for a single query block with key/value blocks (processing the causal mask in stages)."

msgid "`_attn_fwd`：调度所有 query blocks，并管理 block 指针、accumulator 和归一化"
msgstr "`_attn_fwd`: schedules all query blocks and manages block pointers, accumulators, and normalization."

msgid "并通过 PyTorch `autograd.Function` 封装为可调用的 `attention` 函数，与 `torch_npu.npu_fusion_attention` 进行精度对齐验证。"
msgstr "And encapsulate it into a callable `attention` function via PyTorch `autograd.Function`, and perform accuracy alignment verification with `torch_npu.npu_fusion_attention`."

msgid "Out:"
msgstr "Out:"

msgid "上面输出日志表明Triton和PyTorch上的输出结果完全一致。"
msgstr "The output log above indicates that the results from Triton and PyTorch are exactly the same."
